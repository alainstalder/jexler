<ivysettings>
  <settings defaultResolver="downloadGrapes"/>
  <caches lockStrategy="artifact-lock-nio"/>
  <timeout-constraints>
    <timeout-constraint name="remote" connectionTimeout="30000" readTimeout="60000"/>
  </timeout-constraints>
  <typedef name="strict-cached-grapes" classname="groovy.grape.ivy.StrictCachedGrapesResolver"/>
  <resolvers>
    <chain name="downloadGrapes" returnFirst="true">
      <strict-cached-grapes name="cachedGrapes">
        <ivy pattern="/jexler/grape/grapes/[organisation]/[module]/ivy-[revision].xml"/>
        <artifact pattern="/jexler/grape/grapes/[organisation]/[module]/[type]s/[artifact]-[revision](-[classifier]).[ext]"/>
      </strict-cached-grapes>
      <ibiblio name="ibiblio" m2compatible="true" timeoutConstraint="remote"/>
    </chain>
  </resolvers>
</ivysettings>
